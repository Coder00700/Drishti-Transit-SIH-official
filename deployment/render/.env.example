# Server only. Copy to .env locally; never commit real values.
MONGODB_URI=
MONGODB_DATABASE=Users
MONGODB_LOGIN_COLLECTION=login
PUBLICATION_REPLICA_ENABLED=false
PUBLIC_MONGODB_URI=
PUBLIC_DATABASE=DrishtiPublic
PORTAL_ORIGIN=https://YOUR-PAGES-PROJECT.pages.dev
# Generate a random 32+ character value; use the SAME secret in Cloudflare.
EDGE_SHARED_SECRET=
# Closed by default until OTP, privacy review and Mongo indexes are ready.
ALLOW_REGISTRATION=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_VERIFY_EMAIL_ENABLED=false
